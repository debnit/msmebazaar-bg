{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@msmebazaar/shared": [
        "../shared"
      ],
      "@msmebazaar/shared/*": [
        "../shared/*"
      ],
      "@msmebazaar/types": [
        "../shared/types"
      ],
      "@msmebazaar/types/*": [
        "../shared/types/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
