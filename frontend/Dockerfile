# Multi-stage build for Next.js frontend
FROM node:20-alpine AS base

# Install libc6-compat for Alpine compatibility
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Install dependencies stage
FROM base AS deps

# Copy root workspace files
COPY package*.json ./
COPY pnpm-lock.yaml pnpm-workspace.yaml ./   # Add pnpm workspace config
COPY tsconfig.json ./

# Copy entire workspace structure for build context
COPY shared/ ./shared/
COPY frontend/ ./frontend/

# Install latest pnpm globally
RUN npm install -g pnpm@latest

# Install dependencies with workspace support and frozen lockfile
RUN pnpm install --frozen-lockfile --recursive

# Build shared packages
FROM base AS shared-builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY shared/ ./shared/
COPY tsconfig.json ./
RUN cd shared && pnpm run build

# Build Next.js frontend
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=shared-builder /app/shared/dist ./shared/dist
COPY frontend/ ./frontend/
COPY tsconfig.json ./

ENV NEXT_TELEMETRY_DISABLED=1

RUN cd frontend && pnpm run build

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/frontend/public ./public

# Prepare prerender cache directory with ownership
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy standalone build output and static files with correct permissions
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by Next.js standalone output
