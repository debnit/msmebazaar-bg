# API Gateway Local Development Environment
NODE_ENV=development
GATEWAY_PORT=7000
JWT_SECRET=your-super-secret-jwt-key-for-local-development

# Service URLs for local development
AUTH_SERVICE_URL=http://127.0.0.1:8004
PAYMENT_SERVICE_URL=http://localhost:8009
BUYER_SERVICE_URL=http://localhost:8001
SELLER_SERVICE_URL=http://localhost:8002
LOAN_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8008
ADMIN_SERVICE_URL=http://localhost:8009
SUPERADMIN_SERVICE_URL=http://localhost:8010
INVESTOR_SERVICE_URL=http://localhost:8011
AGENT_SERVICE_URL=http://localhost:8012

# Database and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msmebazaar
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# CORS
FRONTEND_URL=http://localhost:3000
